# --- Django ---
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=False
ALLOWED_HOSTS=pcs.victorsmits.com,www.pcs.victorsmits.com

# --- PostgreSQL (prod) ---
POSTGRES_PASSWORD=change-me-in-production

# --- Redis / Celery (renseignés automatiquement en compose prod) ---
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0

# --- Connexion admin via Google (OAuth) ---
# Créer un OAuth Client ID (type Web) dans Google Cloud Console.
# Redirect URI : https://pcs.victorsmits.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Emails autorisés à accéder à l'admin (séparés par des virgules)
ADMIN_EMAILS=victor.smits@shippingbo.com

# --- Notifications Web Push (PWA) ---
# Générer les clés : `python manage.py vapid_keys` puis coller ci-dessous.
# Sans ces clés, le push est simplement désactivé (le reste fonctionne).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@pcs.victorsmits.com

# --- Protection anti-boucle PCS 403 ---
# Après ce nombre de 403 consécutifs, le circuit PCS s'ouvre.
PCS_403_THRESHOLD=2
# Backoff exponentiel en secondes : 1 min, 5 min, 15 min, 30 min, 1 h.
PCS_CIRCUIT_BACKOFFS=60,300,900,1800,3600
# Jitter appliqué au backoff pour éviter les reprises simultanées de workers.
PCS_CIRCUIT_JITTER=0.15
# Délai avant log d'alerte persistante.
PCS_403_ALERT_AFTER_SECONDS=300

# --- Divers ---
CURRENT_SEASON=2026

# --- Image Docker ---
DOCKER_HUB_USERNAME=victorsmits
